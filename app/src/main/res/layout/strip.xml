<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    android:background="@drawable/bg_strip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <FrameLayout
        android:id="@+id/btn_left"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_glass_r14"
        android:clickable="true"
        android:contentDescription="@string/popup_left"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_left"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <View
        android:layout_width="16dp"
        android:layout_height="1dp" />

    <View
        android:id="@+id/dot_gps"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_dot_off" />

    <TextView
        android:id="@+id/tv_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:text="--:--"
        android:textColor="?attr/dpText"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/dpText"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/dpMuted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wx_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_glass"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/iv_weather"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_wx_cloud"
            android:contentDescription="@string/weather_desc"
            android:tint="?attr/dpAccent" />

        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-condensed"
            android:text="--"
            android:textColor="?attr/dpText"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:text="--"
            android:textColor="?attr/dpText"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/speed_unit"
            android:textColor="?attr/dpMuted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_compass"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_compass"
            android:tint="?attr/dpAccent" />

        <TextView
            android:id="@+id/tv_dir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-condensed"
            android:text="K"
            android:textColor="?attr/dpText"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_apps"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_pill_glass"
        android:clickable="true"
        android:contentDescription="@string/all_apps"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_apps"
        android:tint="?attr/dpAccent" />

    <TextView
        android:id="@+id/btn_ratio"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_glass"
        android:clickable="true"
        android:contentDescription="@string/ratio_label"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="52dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="%50"
        android:textColor="?attr/dpAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/btn_swap"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_glass"
        android:clickable="true"
        android:contentDescription="@string/swap_desc"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_swap"
        android:tint="?attr/dpAccent" />

    <View
        android:layout_width="16dp"
        android:layout_height="1dp" />

    <FrameLayout
        android:id="@+id/btn_right"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_glass_r14"
        android:clickable="true"
        android:contentDescription="@string/popup_right"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_right"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
